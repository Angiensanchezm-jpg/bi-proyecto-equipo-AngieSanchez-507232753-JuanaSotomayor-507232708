    </GUI>
  </step>
  <step>
    <name>Agrupa_Descuentos_F2</name>
    <type>MemoryGroupBy</type>
    <description>Consolida total de descuentos por persona para preservar cada peso una sola vez</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>IdContratoDestino</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>TotalDescuentoContratoCOP</aggregate>
        <subject>ValorCOP_Num</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>CantidadActivosDescontados</aggregate>
        <subject>ValorCOP_Num</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>FechasDescuento_List</aggregate>
        <subject>Fecha</subject>
        <type>CONCAT_COMMA</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>FechasReliq_List</aggregate>
        <subject>FECHA DE RELIQUIDACION</subject>
        <type>CONCAT_COMMA</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>704</xloc>
      <yloc>192</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Calcula_Secuencia_Persona</name>
    <type>ScriptValueMod</type>
    <description>Asigna secuencia por colaborador: 1 para el contrato base, >1 para contratos adicionales (recontratación)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Deteccion de casos multi-contrato en ordenamiento secuencial
var prev_codigo;
var seq_contrato;

var cur_cod = "";
if (typeof row !== 'undefined' &amp;&amp; row != null &amp;&amp; typeof row.searchValueIndex === 'function') {
    var idx_cod = row.searchValueIndex("Codigo unico");
    if (idx_cod >= 0) {
        var v_cod = row.getValue(idx_cod);
        if (v_cod != null &amp;&amp; !v_cod.isNull()) {
            cur_cod = trim(v_cod.getString());
        }
    }
} else if (typeof this["Codigo unico"] !== 'undefined' &amp;&amp; this["Codigo unico"] !== null) {
    cur_cod = trim(this["Codigo unico"].toString());
}

if (prev_codigo == null || prev_codigo != cur_cod) {
    seq_contrato = 1;
    prev_codigo = cur_cod;
} else {
    seq_contrato = seq_contrato + 1;
}

var ContratoSecuencia = seq_contrato;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>ContratoSecuencia</name>
        <rename>ContratoSecuencia</rename>
        <type>Integer</type>
        <length>9</length>
        <precision>0</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>704</xloc>
      <yloc>64</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Calcula_Vinculacion_y_Metricas</name>
    <type>ScriptValueMod</type>
    <description>Implementa el manejo estricto de deduplicación de descuentos y cálculo de llaves temporales y estados</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// =============================================================================
// Calcula_Vinculacion_y_Metricas
// Implementacion metodologica rigurosa de asociacion temporal de devoluciones Cubic (F4),
// liquidaciones y jerarquia deterministica de descuentos F2 segun DDL (05_fac_retiro.sql).
// Compatible con Rhino / ES5 (Pentaho PDI 9.4)
// =============================================================================

// Funciones auxiliares de compatibilidad y parsing robusto
function cleanHeader(s) {
    if (s == null) return "";
    return String(s).toUpperCase().replace(/[^A-Z0-9]/g, "");
}

function safeTrim(val) {
    if (val == null) return "";
    var s = null;
    if (typeof val.isNull === 'function' &amp;&amp; val.isNull()) return "";
    if (typeof val.getString === 'function') {
        s = val.getString();
    } else {
        s = String(val);
    }
    if (s == null) return "";
    return String(s).replace(/^\s+|\s+$/g, "");
}

function safeTrimUpper(val) {
    return safeTrim(val).toUpperCase();
}

function findRowValue(names, fallbackPrefix) {
    if (typeof row !== 'undefined' &amp;&amp; row != null &amp;&amp; typeof row.searchValueIndex === 'function') {
        for (var i = 0; i &lt; names.length; i++) {
            var idx = row.searchValueIndex(names[i]);
            if (idx >= 0) {
                var v = row.getValue(idx);
                if (v != null &amp;&amp; !v.isNull()) return v;
            }
        }
        if (fallbackPrefix) {
            var pref = cleanHeader(fallbackPrefix);
            for (var j = 0; j &lt; row.size(); j++) {
                var vCol = row.getValue(j);
                if (vCol != null &amp;&amp; cleanHeader(vCol.getName()).indexOf(pref) >= 0) {
                    if (!vCol.isNull()) return vCol;
                }
            }
        }
    }
    for (var k = 0; k &lt; names.length; k++) {
        if (typeof this[names[k]] !== 'undefined' &amp;&amp; this[names[k]] !== null) {
            return this[names[k]];
        }
    }
    return null;
}

function parseDateValue(val) {
    if (val == null) return null;
    if (typeof val.isNull === 'function' &amp;&amp; val.isNull()) return null;
    if (typeof val.isDate === 'function' &amp;&amp; val.isDate()) {
        var jd = val.getDate();
        return jd != null ? new Date(jd.getTime()) : null;
    }
    var s = safeTrim(val);
    if (s == "" || s == "-" || s == "0" || s.indexOf("#") >= 0 || s.toUpperCase() == "NULL" || s.toUpperCase() == "NONE") {
        return null;
    }
    var num = Number(s);
    if (!isNaN(num) &amp;&amp; num > 10000 &amp;&amp; num &lt; 100000) {
        var utc_days = Math.floor(num - 25569);
        var utc_value = utc_days * 86400;
        var date_info = new Date(utc_value * 1000);
        return new Date(date_info.getUTCFullYear(), date_info.getUTCMonth(), date_info.getUTCDate());
    }
    var parts = s.split(/[-/ :]/);
    if (parts.length >= 3) {
        var p0 = parseInt(parts[0], 10);
        var p1 = parseInt(parts[1], 10);
        var p2 = parseInt(parts[2], 10);
        if (p0 > 1900) return new Date(p0, p1 - 1, p2);
        if (p2 > 1900) return new Date(p2, p1 - 1, p0);
    }
    var d = new Date(s);
    return isNaN(d.getTime()) ? null : d;
}

function formatFechaKey(d) {
    if (d == null) return -1;
    var yr = d.getFullYear();
    var mo = d.getMonth() + 1;
    var dy = d.getDate();
    return yr * 10000 + mo * 100 + dy;
}

function toMidnight(d) {
    if (d == null) return null;
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), 0, 0, 0, 0);
}

// Conteo sustentado de activos pendientes desde el texto de la fuente
function parsePendingAssetsCount(val) {
    if (val == null) return null;
    var raw = safeTrimUpper(val);
    if (raw == "" || raw == "NULL" || raw == "NONE") {
        return null;
    }
    if (raw.indexOf("NO TIENE") >= 0 || raw.indexOf("SIN ACTIVOS") >= 0 || raw == "-" || raw == "0") {
        return 0;
    }
    if (raw == "TIENE ACTIVOS") {
        return null;
    }
    var regexAsset = /\b(\d{1,2})\s+(CPU|MONITOR|DIADEMA|TOKEN|YUBIKEY|PORTATIL|TABLET|CAMARA|CARGADOR|TECLADO|MOUSE)\b/g;
    var matches = [];
    var match;
    while ((match = regexAsset.exec(raw)) !== null) {
        matches.push(parseInt(match[1], 10));
    }
    if (matches.length == 0) return null;
    var allNumbers = raw.match(/\b\d+\b/g);
    if (allNumbers != null &amp;&amp; allNumbers.length != matches.length) return null;
    var totalAssets = 0;
    for (var k = 0; k &lt; matches.length; k++) {
        totalAssets += matches[k];
    }
    return totalAssets;
}

// =============================================================================
// SECCION 1: IDENTIFICACION DEL COLABORADOR Y REINICIO DE ESTADO
// =============================================================================
var v_cod_cur = findRowValue(["Codigo unico"], "CodigoUnico");
var cur_colab_cod = safeTrim(v_cod_cur);

if (prev_colab_codigo == null || prev_colab_codigo != cur_colab_cod) {
    prev_colab_codigo = cur_colab_cod;
    next_contract_start = null; // Primer contrato en orden cronologico inverso (mas reciente)
    used_cubic_timestamps = {}; // Reiniciar registro de devoluciones consumidas
    used_discount_assigned = false; // Garantiza asignacion univoca (cero duplicacion) de descuentos
}

var v_sec = findRowValue(["ContratoSecuencia"], "ContratoSecuencia");
var sec = 1;
if (v_sec != null &amp;&amp; (typeof v_sec.isNull !== 'function' || !v_sec.isNull())) {
    if (typeof v_sec.getInteger === 'function') sec = v_sec.getInteger();
    else sec = parseInt(v_sec, 10);
    if (isNaN(sec)) sec = 1;
}

// =============================================================================
// SECCION 2: RESOLUCION Y PARSING DE FECHAS DEL CONTRATO (DISPONIBILIDAD INMEDIATA)
// =============================================================================
var v_rep = findRowValue(["Fecha Reportado"], "FechaReportado");
var v_baja = findRowValue(["Fecha de baja"], "Fechadebaja");
var v_ult = findRowValue(["Último Día Laboral", "Ultimo Dia Laboral", "ltimo Da Laboral"], "ULTIMODIALABORAL");
var v_liq = findRowValue(["Fecha liquidacion"], "Fechaliquidacion");
var v_reliq = findRowValue(["Fecha de Reliquidación", "Fecha de Reliquidacion"], "RELIQUIDACI");
var v_act = findRowValue(["Activos asignados actualmente"], "Activosasignadosactualmente");
var v_act_term = findRowValue(["Activos asignados al terminar"], "Activosasignadosalterminar");
var v_est_liq = findRowValue(["Estado Liquidación", "Estado Liquidacion"], "ESTADOLIQUIDACI");
var v_flag_desc = safeTrimUpper(findRowValue(["¿Con descuento?", "Con descuento", "ConDescuento"], "CONDESCUENTO"));

var f_rep = parseDateValue(v_rep);
var f_baja = parseDateValue(v_baja);
var f_ult = parseDateValue(v_ult);
var f_liq = parseDateValue(v_liq);
var f_reliq = parseDateValue(v_reliq);

var FechaReporteKey = formatFechaKey(f_rep);
var FechaLiquidacionKey = formatFechaKey(f_liq);
var FechaReliquidacionKey = formatFechaKey(f_reliq);

// =============================================================================
// SECCION 3: CALCULO NORMALIZADO DE DIAS DE LIQUIDACION (MEDIANOCHE LOCAL)
// =============================================================================
var d_rep_mid = toMidnight(f_rep);
var d_liq_mid = toMidnight(f_liq);

var DiasReporteLiquidacion = null;
if (d_rep_mid != null &amp;&amp; d_liq_mid != null) {
    DiasReporteLiquidacion = Math.round((d_liq_mid.getTime() - d_rep_mid.getTime()) / (1000 * 60 * 60 * 24));
}

var LiquidadoEn10Dias_0_1 = (DiasReporteLiquidacion != null &amp;&amp; DiasReporteLiquidacion >= 0 &amp;&amp; DiasReporteLiquidacion &lt;= 10) ? 1 : 0;
var CasoConReliquidacion_0_1 = (FechaReliquidacionKey != -1) ? 1 : 0;

// =============================================================================
// SECCION 4: ASOCIACION TEMPORAL DETERMINISTICA CON HISTORIAL CUBIC (F4)
// Ventana contractual [f_inicio_retiro, f_limite_siguiente) sin plazos inventados
// =============================================================================
var f_inicio_retiro = null;
if (f_rep != null) f_inicio_retiro = f_rep;
if (f_ult != null &amp;&amp; (f_inicio_retiro == null || f_ult.getTime() &lt; f_inicio_retiro.getTime())) f_inicio_retiro = f_ult;
if (f_baja != null &amp;&amp; (f_inicio_retiro == null || f_baja.getTime() &lt; f_inicio_retiro.getTime())) f_inicio_retiro = f_baja;

var f_limite_siguiente = next_contract_start;
var is_window_inverted_or_collapsed = (f_limite_siguiente != null &amp;&amp; f_inicio_retiro != null 
                                      &amp;&amp; f_inicio_retiro.getTime() >= f_limite_siguiente.getTime());

if (f_inicio_retiro != null) {
    if (next_contract_start == null || f_inicio_retiro.getTime() &lt; next_contract_start.getTime()) {
        next_contract_start = f_inicio_retiro;
    }
}

var v_dev_min = findRowValue(["FechaDevolucionCubic_Min"], "FechaDevolucionCubic_Min");
var v_dev_max = findRowValue(["FechaDevolucionCubic_Max"], "FechaDevolucionCubic_Max");
var v_dev_list = findRowValue(["FechasDevolucionCubic_List"], "FechasDevolucionCubic_List");
var v_dev_count = findRowValue(["CantidadDevolucionesCubic"], "CantidadDevolucionesCubic");

var f_dev_min = parseDateValue(v_dev_min);
var f_dev_max = parseDateValue(v_dev_max);
var cnt_dev = 0;
if (v_dev_count != null &amp;&amp; !v_dev_count.isNull()) {
    if (typeof v_dev_count.getInteger === 'function') cnt_dev = v_dev_count.getInteger();
    else cnt_dev = parseInt(v_dev_count, 10);
    if (isNaN(cnt_dev)) cnt_dev = 0;
}

var cubic_dates = [];
var str_dev_list = safeTrim(v_dev_list);
if (str_dev_list != "") {
    var raw_tokens = str_dev_list.split(/[,;\t\n]+/);
    for (var ti = 0; ti &lt; raw_tokens.length; ti++) {
        var pd = parseDateValue(raw_tokens[ti]);
        if (pd != null) cubic_dates.push(pd);
    }
}
if (cubic_dates.length == 0) {
    if (f_dev_min != null) cubic_dates.push(f_dev_min);
    if (f_dev_max != null &amp;&amp; (f_dev_min == null || f_dev_max.getTime() != f_dev_min.getTime())) {
        cubic_dates.push(f_dev_max);
    }
}

var act_term_raw = safeTrimUpper(v_act_term);
var act_raw = safeTrimUpper(v_act);

var term_explicit_no_assets = (act_term_raw == "-" || act_term_raw == "0" 
                              || act_term_raw.indexOf("NO TIENE") >= 0 
                              || act_term_raw.indexOf("SIN ACTIVOS") >= 0);

var current_explicit_has_assets = (act_raw != "" &amp;&amp; act_raw != "-" &amp;&amp; act_raw != "0" 
                                  &amp;&amp; act_raw != "NULL" &amp;&amp; act_raw != "NONE" 
                                  &amp;&amp; act_raw.indexOf("NO TIENE") &lt; 0 
                                  &amp;&amp; act_raw.indexOf("SIN ACTIVOS") &lt; 0);

var is_sin_activos_certified = term_explicit_no_assets &amp;&amp; !current_explicit_has_assets &amp;&amp; cnt_dev == 0;
var is_sin_activos_explicit = (act_raw == "0" || act_raw == "-" || act_raw.indexOf("NO TIENE") >= 0 || act_raw.indexOf("SIN ACTIVOS") >= 0);

var f_dev = null;
var DiasReporteDevolucion = null;

if (!is_sin_activos_certified &amp;&amp; f_inicio_retiro != null &amp;&amp; !is_window_inverted_or_collapsed) {
    var matched_devs = [];
    for (var ci = 0; ci &lt; cubic_dates.length; ci++) {
        var cd = cubic_dates[ci];
        var cd_time = cd.getTime();
        if (cd_time >= f_inicio_retiro.getTime() &amp;&amp; (f_limite_siguiente == null || cd_time &lt; f_limite_siguiente.getTime())) {
            if (!used_cubic_timestamps[cd_time]) {
                matched_devs.push(cd);
            }
        }
    }
    
    if (matched_devs.length > 0) {
        var max_dev = matched_devs[0];
        for (var mi = 1; mi &lt; matched_devs.length; mi++) {
            if (matched_devs[mi].getTime() > max_dev.getTime()) {
                max_dev = matched_devs[mi];
            }
        }
        f_dev = max_dev;
        used_cubic_timestamps[f_dev.getTime()] = true;
        
        if (f_rep != null) {
            var d_dev_mid = toMidnight(f_dev);
            DiasReporteDevolucion = (d_rep_mid != null &amp;&amp; d_dev_mid != null) ? Math.round((d_dev_mid.getTime() - d_rep_mid.getTime()) / (1000 * 60 * 60 * 24)) : null;
        } else {
            DiasReporteDevolucion = null;
        }
    }
}

var FechaDevolucionKey = formatFechaKey(f_dev);

// Evaluacion de estado de devolucion y activos pendientes
var is_multi_contract = (sec > 1 || f_limite_siguiente != null);
var EstadoDevolucion = "SIN ACTIVOS";
var CantidadActivosPendientes = 0;

if (is_sin_activos_certified) {
    EstadoDevolucion = "SIN ACTIVOS";
    CantidadActivosPendientes = 0;
    f_dev = null;
    FechaDevolucionKey = -1;
    DiasReporteDevolucion = null;
} else if (is_window_inverted_or_collapsed || f_inicio_retiro == null) {
    EstadoDevolucion = "PENDIENTE";
    CantidadActivosPendientes = parsePendingAssetsCount(v_act);
    f_dev = null;
    FechaDevolucionKey = -1;
    DiasReporteDevolucion = null;
} else if (is_sin_activos_explicit &amp;&amp; f_dev != null) {
    if (is_multi_contract || cnt_dev > 1) {
        EstadoDevolucion = "PENDIENTE";
        CantidadActivosPendientes = 0;
    } else {
        EstadoDevolucion = "COMPLETA";
        CantidadActivosPendientes = 0;
    }
} else {
    EstadoDevolucion = "PENDIENTE";
    CantidadActivosPendientes = parsePendingAssetsCount(v_act);
    if (f_dev == null) {
        FechaDevolucionKey = -1;
        DiasReporteDevolucion = null;
    }
}

var est_liq_raw = safeTrimUpper(v_est_liq);
var EstadoLiquidacionNorm = "Liquidado";
if (est_liq_raw.indexOf("RELIQUIDADO") >= 0) {
    EstadoLiquidacionNorm = "Reliquidado";
} else if (est_liq_raw.indexOf("PENDIENTE") >= 0 || f_liq == null) {
    EstadoLiquidacionNorm = "Pendiente Liquidar";
} else {
    EstadoLiquidacionNorm = "Liquidado";
}

// =============================================================================
// SECCION 5: DEFINICION DE VARIABLES Y JERARQUIA DE ASIGNACION DE DESCUENTOS (F2)
// Variables definidas formal y deterministicamente en tiempo de ejecucion:
// 1. total_desc: Monto total de descuentos registrado para el colaborador en F2
// 2. is_multi_colab: Verdadero si el colaborador tiene multiples contratos de retiro
// 3. f_desc_liq_match: Coincidencia exacta con Fecha de Liquidacion del contrato
// 4. f_desc_reliq_match: Coincidencia exacta con Fecha de Reliquidacion del contrato
// =============================================================================

// 1. Obtencion de campos de novedad de descuentos F2
var v_desc = findRowValue(["TotalDescuentoContratoCOP", "TotalDescuentoPersonaCOP"], "TotalDescuento");
var total_desc = 0.0;
if (v_desc != null &amp;&amp; (typeof v_desc.isNull !== 'function' || !v_desc.isNull())) {
    if (typeof v_desc.getNumber === 'function') total_desc = v_desc.getNumber();
    else total_desc = parseFloat(v_desc);
    if (isNaN(total_desc)) total_desc = 0.0;
}

// 2. Evaluacion de multiplicidad contractual del colaborador
var v_total_c = findRowValue(["TotalContratosF1", "TotalContratosPersona"], "TotalContratos");
var is_multi_colab = false;
if (v_total_c != null &amp;&amp; !v_total_c.isNull()) {
    var tc_num = (typeof v_total_c.getInteger === 'function') ? v_total_c.getInteger() : parseInt(v_total_c, 10);
    if (!isNaN(tc_num) &amp;&amp; tc_num > 1) is_multi_colab = true;
}
if (!is_multi_colab) {
    // Si no viene campo agregado, se determina por secuencia y ventana temporal del colaborador
    is_multi_colab = (sec > 1 || f_limite_siguiente != null);
}

// 3. Evaluacion de coincidencia con Fecha de Liquidacion (Nivel 2)
var v_desc_list = findRowValue(["FechasDescuento_List", "FechasDescuento"], "FechasDescuento");
var str_desc_list = safeTrim(v_desc_list);
var f_desc_liq_match = false;

if (f_liq != null &amp;&amp; str_desc_list != "") {
    var cur_liq_key = FechaLiquidacionKey;
    var tokens_desc = str_desc_list.split(/[,;\t\n]+/);
    for (var di = 0; di &lt; tokens_desc.length; di++) {
        var d_p = parseDateValue(tokens_desc[di]);
        if (d_p != null &amp;&amp; formatFechaKey(d_p) == cur_liq_key) {
            f_desc_liq_match = true;
            break;
        }
    }
}

// 4. Evaluacion de coincidencia con Fecha de Reliquidacion (Nivel 3)
var v_reliq_list = findRowValue(["FechasReliq_List", "FechasReliq"], "FechasReliq");
var str_reliq_list = safeTrim(v_reliq_list);
var f_desc_reliq_match = false;

if (f_reliq != null &amp;&amp; str_reliq_list != "") {
    var cur_reliq_key = FechaReliquidacionKey;
    var tokens_reliq = str_reliq_list.split(/[,;\t\n]+/);
    for (var ri = 0; ri &lt; tokens_reliq.length; ri++) {
        var r_p = parseDateValue(tokens_reliq[ri]);
        if (r_p != null &amp;&amp; formatFechaKey(r_p) == cur_reliq_key) {
            f_desc_reliq_match = true;
            break;
        }
    }
}

// =============================================================================
// EVALUACION DE LA JERARQUIA DETERMINISTICA (DDL 05_fac_retiro.sql)
// =============================================================================
var ValorDescontadoCOP = 0.00;
var TipoVinculacionDescuento = "SIN_DESCUENTO";
var MotivoAjusteDescuento = "Sin novedad de descuento registrada en F2 o asignada a otro contrato";
var CasoConDescuento_0_1 = 0;

if (total_desc > 0 &amp;&amp; !used_discount_assigned) {
    if (!is_multi_colab &amp;&amp; sec == 1) {
        // Nivel 1: VINCULACION_DIRECTA_1_A_1 (Colaborador mono-contrato univoco)
        ValorDescontadoCOP = total_desc;
        CasoConDescuento_0_1 = 1;
        TipoVinculacionDescuento = "VINCULACION_DIRECTA_1_A_1";
        MotivoAjusteDescuento = "Vinculo 1:1 directo mono-contrato sin ambiguedad";
        used_discount_assigned = true;
    } else if (f_desc_liq_match) {
        // Nivel 2: VINCULACION_MULTI_LIQ (Coincidencia con Fecha Liquidacion)
        ValorDescontadoCOP = total_desc;
        CasoConDescuento_0_1 = 1;
        TipoVinculacionDescuento = "VINCULACION_MULTI_LIQ";
        MotivoAjusteDescuento = "Vinculo univoco por coincidencia exacta de fecha de liquidacion";
        used_discount_assigned = true;
    } else if (f_desc_reliq_match) {
        // Nivel 3: VINCULACION_MULTI_RELIQ (Coincidencia con Fecha Reliquidacion)
        ValorDescontadoCOP = total_desc;
        CasoConDescuento_0_1 = 1;
        TipoVinculacionDescuento = "VINCULACION_MULTI_RELIQ";
        MotivoAjusteDescuento = "Vinculo univoco por coincidencia exacta de fecha de reliquidacion";
        used_discount_assigned = true;
    } else if (v_flag_desc == "SI" || v_flag_desc == "SÍ") {
        // Nivel 4: VINCULACION_MULTI_FLAG (Indicador unico 'Con descuento = Si')
        ValorDescontadoCOP = total_desc;
        CasoConDescuento_0_1 = 1;
        TipoVinculacionDescuento = "VINCULACION_MULTI_FLAG";
        MotivoAjusteDescuento = "Vinculo univoco por indicador unico de descuento en F1";
        used_discount_assigned = true;
    } else if (sec == 1 &amp;&amp; !is_multi_colab) {
        // Fallback controlado para colaborador mono-contrato
        ValorDescontadoCOP = total_desc;
        CasoConDescuento_0_1 = 1;
        TipoVinculacionDescuento = "VINCULACION_DIRECTA_1_A_1";
        MotivoAjusteDescuento = "Vinculo 1:1 directo mono-contrato asignado a contrato principal";
        used_discount_assigned = true;
    } else {
        // Multi-contrato sin coincidencia contractual unica (aislado en fac_descuento_conciliacion)
        ValorDescontadoCOP = 0.00;
        CasoConDescuento_0_1 = 0;
        TipoVinculacionDescuento = "SIN_DESCUENTO";
        MotivoAjusteDescuento = "Colaborador multi-contrato sin coincidencia contractual unica (aislado en fac_descuento_conciliacion)";
    }
} else {
    ValorDescontadoCOP = 0.00;
    CasoConDescuento_0_1 = 0;
    TipoVinculacionDescuento = "SIN_DESCUENTO";
    MotivoAjusteDescuento = (total_desc > 0) ? "Novedad de descuento ya atribuida a contrato precedente del colaborador" : "Sin descuento registrado en F2 para este contrato especifico";
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>ValorDescontadoCOP</name>
        <rename>ValorDescontadoCOP</rename>
        <type>BigNumber</type>
        <length>15</length>
