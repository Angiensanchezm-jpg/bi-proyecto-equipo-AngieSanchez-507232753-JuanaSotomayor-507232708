  <step>
    <name>Limpia_F2_ValorCOP</name>
    <type>ScriptValueMod</type>
    <description>E3: Limpieza de formato moneda COP en campo VALOR EN PESOS</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// =============================================================================
// Limpia_F2_ValorCOP
// E3: Limpieza de formato moneda COP en campo VALOR EN PESOS y normalizacion de claves
// Consumo estricto y nativo de campos entregados por Lee_Activos_Descuentos_F2 (ExcelInput)
// SIN dependencias de Apache POI (WorkbookFactory, org.apache.poi.*) ni lectura externa de archivos
// Compatible con Rhino / ES5 (Pentaho PDI 9.4)
// =============================================================================

var raw_val_str = "";
var raw_cod_str = "";

// 1. Acceso seguro no posicional por compatibilidad Pentaho PDI 9.4 (Row) y fallback por propiedades
if (typeof row !== 'undefined' &amp;&amp; row != null &amp;&amp; typeof row.searchValueIndex === 'function') {
    var idx_val = row.searchValueIndex("VALOR EN PESOS");
    if (idx_val >= 0) {
        var v_val = row.getValue(idx_val);
        if (v_val != null &amp;&amp; !v_val.isNull()) {
            if (typeof v_val.getString === 'function') {
                raw_val_str = trim(v_val.getString());
            } else {
                raw_val_str = trim(String(v_val));
            }
        }
    }
    var idx_cod = row.searchValueIndex("Codigo unico");
    if (idx_cod >= 0) {
        var v_cod = row.getValue(idx_cod);
        if (v_cod != null &amp;&amp; !v_cod.isNull()) {
            if (typeof v_cod.getString === 'function') {
                raw_cod_str = trim(v_cod.getString());
            } else {
                raw_cod_str = trim(String(v_cod));
            }
        }
    }
} else {
    if (typeof this["VALOR EN PESOS"] !== 'undefined' &amp;&amp; this["VALOR EN PESOS"] !== null) {
        raw_val_str = trim(String(this["VALOR EN PESOS"]));
    }
    if (typeof this["Codigo unico"] !== 'undefined' &amp;&amp; this["Codigo unico"] !== null) {
        raw_cod_str = trim(String(this["Codigo unico"]));
    }
}

// 2. Normalizacion de Codigo unico (eliminar sufijo .0 si ExcelInput/POI lo entrego como numerico)
var CodigoF2_Norm = raw_cod_str;
if (CodigoF2_Norm != null &amp;&amp; CodigoF2_Norm != "") {
    if (CodigoF2_Norm.indexOf(".") >= 0) {
        var parts_cod = CodigoF2_Norm.split(".");
        if (parts_cod.length == 2 &amp;&amp; parts_cod[1] == "0") {
            CodigoF2_Norm = parts_cod[0];
        }
    }
}

// 3. Limpieza estricta de formato de moneda COP (preservando decimales y flotantes nativos)
var val_raw = raw_val_str;
var ValorCOP_Num = 0.0;

if (val_raw != null &amp;&amp; val_raw != "") {
    // Si contiene error de formula Excel (#REF!, #N/A, etc.), el valor es 0.0
    if (val_raw.indexOf("#") >= 0) {
        ValorCOP_Num = 0.0;
    } else if (val_raw.indexOf(",") >= 0 &amp;&amp; val_raw.indexOf(".") &lt; 0 &amp;&amp; val_raw.indexOf("$") &lt; 0) {
        // Formato con coma decimal hispana (ej: "150000,50")
        var s_dec = val_raw.replace(/ /g, "").replace(",", ".");
        var n_dec = parseFloat(s_dec);
        if (!isNaN(n_dec)) ValorCOP_Num = n_dec;
    } else if (val_raw.indexOf("$") >= 0 || (val_raw.split(".").length > 2)) {
        // Formato con signo $ o puntos de miles (ej: "$ 150.000" o "$150.000.00")
        var s_mil = val_raw.replace("$", "").replace(/\./g, "").replace(/ /g, "");
        var n_mil = parseFloat(s_mil);
        if (!isNaN(n_mil)) ValorCOP_Num = n_mil;
    } else {
        // Formato numerico nativo / float con punto decimal (ej: "150000.5")
        var s_num = val_raw.replace(/ /g, "");
        var n_num = parseFloat(s_num);
        if (!isNaN(n_num)) ValorCOP_Num = n_num;
    }
}

// 4. Clave de destino para agrupacion y cruce deterministico por colaborador
var IdContratoDestino = CodigoF2_Norm;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>ValorCOP_Num</name>
        <rename>ValorCOP_Num</rename>
        <type>BigNumber</type>
        <length>15</length>
        <precision>2</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>CodigoF2_Norm</name>
        <rename>CodigoF2_Norm</rename>
        <type>String</type>
        <length>50</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>IdContratoDestino</name>
        <rename>IdContratoDestino</rename>
        <type>String</type>
        <length>50</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
