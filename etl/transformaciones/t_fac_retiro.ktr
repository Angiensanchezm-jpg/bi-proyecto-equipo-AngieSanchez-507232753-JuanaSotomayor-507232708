<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t_fac_retiro</name>
    <description>Carga de tabla de hechos fac_retiro integrando F1 (Paz y Salvos), F2 (Activos y Descuentos) y F4 (Historial Cubic), resolviendo llaves dimensionales y deduplicando pasivos monetarios multi-contrato sin inventar reglas arbitrarias de asignación.</description>
    <extended_description/>
    <trans_version>2.0</trans_version>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>DB_HOST</name>
        <default_value>localhost</default_value>
        <description>Host de MySQL</description>
      </parameter>
      <parameter>
        <name>DB_NAME</name>
        <default_value>bi_entrega2</default_value>
        <description>Nombre de la base de datos</description>
      </parameter>
      <parameter>
        <name>DB_PASSWORD</name>
        <default_value/>
        <description>Contraseña de MySQL</description>
      </parameter>
      <parameter>
        <name>DB_PORT</name>
        <default_value>3306</default_value>
        <description>Puerto de MySQL</description>
      </parameter>
      <parameter>
        <name>DB_USER</name>
        <default_value>bi_entrega2_user</default_value>
        <description>Usuario de MySQL (seguridad del proyecto)</description>
      </parameter>
      <parameter>
        <name>RUTA_CUBIC</name>
        <default_value>${Internal.Entry.Current.Directory}/../../datos/raw/Historial Cubic.xlsx</default_value>
        <description>Ubicación de Historial Cubic XLSX (F4)</description>
      </parameter>
      <parameter>
        <name>RUTA_DESCUENTOS</name>
        <default_value>${Internal.Entry.Current.Directory}/../../datos/raw/Activos y Descuentos.xlsx</default_value>
        <description>Ubicación de Activos y Descuentos XLSX (F2)</description>
      </parameter>
      <parameter>
        <name>RUTA_PAZ_Y_SALVOS</name>
        <default_value>${Internal.Entry.Current.Directory}/../../datos/raw/Paz y Salvos.xlsx</default_value>
        <description>Ubicación de Paz y Salvos XLSX (F1)</description>
      </parameter>
    </parameters>
