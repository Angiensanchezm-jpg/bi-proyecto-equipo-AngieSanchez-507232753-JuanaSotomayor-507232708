  <step>
    <name>Filtra_Solo_Invalidos_NA</name>
    <type>FilterRows</type>
    <description>Filtra exactamente los 861 registros con #N/A o codigo nulo en F2</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Enriquece_Metadatos_Descarte_F2</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>Codigo_unico</leftvalue>
            <function>IS NULL</function>
            <rightvalue/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>OR</operator>
            <leftvalue>Codigo_unico</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text>#N/A</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>OR</operator>
            <leftvalue>Codigo_unico</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text/>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>Y</isnull>
              <mask/>
            </value>
          </condition>
        </conditions>
      </condition>
    </compare>
