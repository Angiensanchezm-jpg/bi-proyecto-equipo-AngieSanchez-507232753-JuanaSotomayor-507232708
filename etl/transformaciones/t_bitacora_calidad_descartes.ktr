  <order>
    <!-- Flujo F2: descartes de Activos y Descuentos -->
    <hop>
      <from>Lee_Activos_Descuentos_F2</from>
      <to>Renombra_Campos_F2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Renombra_Campos_F2</from>
      <to>Filtra_Solo_Invalidos_NA</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filtra_Solo_Invalidos_NA</from>
      <to>Enriquece_Metadatos_Descarte_F2</to>
