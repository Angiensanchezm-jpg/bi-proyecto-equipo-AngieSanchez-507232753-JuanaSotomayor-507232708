    </hop>
    <hop>
      <from>Selecciona_8_Campos_F2</from>
      <to>Union_Descartes</to>
      <enabled>Y</enabled>
    </hop>

    <!-- Flujo F1: descartes por Id nulo en Paz y Salvos -->
    <hop>
      <from>Lee_Paz_y_Salvos_F1</from>
      <to>Filtra_F1_Nulo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filtra_F1_Nulo</from>
      <to>Enriquece_F1_Nulo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Enriquece_F1_Nulo</from>
      <to>Selecciona_8_Campos_F1_Nulo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Selecciona_8_Campos_F1_Nulo</from>
      <to>Union_Descartes</to>
      <enabled>Y</enabled>
    </hop>

    <!-- Flujo F1: descartes por Id duplicado en Paz y Salvos -->
    <hop>
      <from>Filtra_F1_Nulo</from>
      <to>Ordena_F1_Validos_Por_Id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordena_F1_Validos_Por_Id</from>
      <to>Detecta_F1_Duplicados</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Detecta_F1_Duplicados</from>
      <to>Filtra_Solo_Duplicados_F1</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filtra_Solo_Duplicados_F1</from>
      <to>Enriquece_F1_Duplicado</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Enriquece_F1_Duplicado</from>
      <to>Selecciona_8_Campos_F1_Duplicado</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Selecciona_8_Campos_F1_Duplicado</from>
      <to>Union_Descartes</to>
      <enabled>Y</enabled>
    </hop>

    <!-- Carga final consolidada -->
    <hop>
      <from>Union_Descartes</from>
      <to>Carga_bitacora_calidad_descartes</to>
      <enabled>Y</enabled>
    </hop>
