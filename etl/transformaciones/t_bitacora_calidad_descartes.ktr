  <step>
    <name>Enriquece_Metadatos_Descarte_F2</name>
    <type>ScriptValueMod</type>
    <description>Genera trazabilidad de auditoria y limpia monto COP de F2</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
function getVal(v) {
    if (v == null) return "";
    if (typeof v.isNull === 'function' &amp;&amp; v.isNull()) return "";
    if (typeof v.getString === 'function') {
        var s = v.getString();
        return (s == null) ? "" : String(s).replace(/^\s+|\s+$/g, "");
    }
    return String(v).replace(/^\s+|\s+$/g, "");
}

function getFieldVal(fieldVar, fieldName) {
    if (typeof fieldVar !== 'undefined' &amp;&amp; fieldVar != null) {
        return getVal(fieldVar);
    }
    if (typeof this !== 'undefined' &amp;&amp; this != null &amp;&amp; typeof this[fieldName] !== 'undefined' &amp;&amp; this[fieldName] != null) {
        return getVal(this[fieldName]);
    }
    if (typeof row !== 'undefined' &amp;&amp; row != null &amp;&amp; typeof row.searchValueIndex === 'function') {
        var idx = row.searchValueIndex(fieldName);
        if (idx >= 0) {
            var v = row.getValue(idx);
            if (v != null) return getVal(v);
        }
    }
    return "";
}

var raw_cod = getFieldVal(typeof Codigo_unico !== 'undefined' ? Codigo_unico : null, "Codigo_unico");
var raw_id  = getFieldVal(typeof ID_ACTIVO !== 'undefined' ? ID_ACTIVO : null, "ID_ACTIVO");
var raw_nom = getFieldVal(typeof NOMBRE_ACTIVO !== 'undefined' ? NOMBRE_ACTIVO : null, "NOMBRE_ACTIVO");
var raw_val = getFieldVal(typeof VALOR_EN_PESOS !== 'undefined' ? VALOR_EN_PESOS : null, "VALOR_EN_PESOS");

var FuenteOrigen = "F2: Activos y Descuentos";
var CodigoColaboradorOrigen = (raw_cod == "" || raw_cod == "#N/A") ? "#N/A" : raw_cod;
var IdActivo = raw_id;
var NombreActivo = raw_nom;

var ValorMonetarioCOP = 0.0;
if (raw_val != "") {
    var s = raw_val.replace(/\$/g, "").replace(/\./g, "").replace(/\s/g, "").replace(/,/g, ".");
    var n = parseFloat(s);
    if (!isNaN(n)) {
        ValorMonetarioCOP = n;
    }
}

var ReglaCalidad = "F2.R1_CODIGO_COLABORADOR_NA";
var DescripcionAnomalia = "Registro en F2 con código único #N/A; imposible asociar a colaborador o contrato formal";
var AccionTomada = "Aislado en bitacora_calidad_descartes sin alterar grano analítico";
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
