  <step>
    <name>Detecta_F1_Duplicados</name>
    <type>ScriptValueMod</type>
    <description>Marca duplicados comparando con el registro previo ordenado</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel/>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
function getVal(v) {
    if (v == null) return "";
    if (typeof v.isNull === 'function' &amp;&amp; v.isNull()) return "";
    if (typeof v.getString === 'function') {
        var s = v.getString();
        return (s == null) ? "" : String(s).replace(/^\s+|\s+$/g, "");
    }
    return String(v).replace(/^\s+|\s+$/g, "");
}

function getFieldVal(fieldVar, fieldName, rowIdx) {
    if (typeof fieldVar !== 'undefined' &amp;&amp; fieldVar != null) return getVal(fieldVar);
    if (typeof this !== 'undefined' &amp;&amp; this != null &amp;&amp; typeof this[fieldName] !== 'undefined' &amp;&amp; this[fieldName] != null) return getVal(this[fieldName]);
    if (typeof row !== 'undefined' &amp;&amp; row != null) {
        if (typeof row.searchValueIndex === 'function') {
            var idx = row.searchValueIndex(fieldName);
            if (idx >= 0) {
                var v = row.getValue(idx);
                if (v != null) return getVal(v);
            }
        }
        if (typeof rowIdx === 'number' &amp;&amp; row.length > rowIdx &amp;&amp; row[rowIdx] != null) {
            return getVal(row[rowIdx]);
        }
    }
    return "";
}

var cur_id = getFieldVal(typeof Id !== 'undefined' ? Id : null, "Id", 1);
var es_duplicado = false;
if (typeof prev_id_f1 !== 'undefined' &amp;&amp; cur_id != "" &amp;&amp; cur_id == prev_id_f1) {
    es_duplicado = true;
} else {
    var prev_id_f1 = cur_id;
    es_duplicado = false;
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>es_duplicado</name>
