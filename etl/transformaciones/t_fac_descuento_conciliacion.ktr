    <name>Normaliza_F1_Contratos</name>
    <type>ScriptValueMod</type>
    <description>Normaliza fechas y flags de F1 para agrupacion por colaborador</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
