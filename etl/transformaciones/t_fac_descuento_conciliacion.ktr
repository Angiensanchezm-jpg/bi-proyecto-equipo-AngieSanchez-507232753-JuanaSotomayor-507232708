  <step>
    <name>Limpia_F2_Campos</name>
    <type>ScriptValueMod</type>
    <description>Limpieza y normalizacion de moneda, fechas y claves</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel/>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// =============================================================================

// Limpia_F2_Campos

// Acceso no posicional a campos por nombre real segun compatibilidad Pentaho PDI 9.4

// Patron homologado con t_fac_retiro.ktr

// =============================================================================



function cleanHeader(s) {

    if (s == null) return "";

    return String(s).toUpperCase().replace(/[^A-Z0-9]/g, "");

}



function safeTrim(val) {

    if (val == null) return "";

    var s = null;

    if (typeof val.isNull === 'function' &amp;&amp; val.isNull()) return "";

    if (typeof val.getString === 'function') {

        s = val.getString();

    } else {

        s = String(val);

    }

    if (s == null) return "";

    return String(s).replace(/^\s+|\s+$/g, "");

}



function findRowValue(names, fallbackPrefix) {

    if (typeof row !== 'undefined' &amp;&amp; row != null &amp;&amp; typeof row.searchValueIndex === 'function') {

        for (var i = 0; i &lt; names.length; i++) {

            var idx = row.searchValueIndex(names[i]);

            if (idx >= 0) {

                var v = row.getValue(idx);

                if (v != null &amp;&amp; !v.isNull()) return v;

            }

        }

        if (fallbackPrefix) {

            var pref = cleanHeader(fallbackPrefix);

            for (var j = 0; j &lt; row.size(); j++) {

                var vCol = row.getValue(j);

                if (vCol != null &amp;&amp; cleanHeader(vCol.getName()).indexOf(pref) >= 0) {

                    if (!vCol.isNull()) return vCol;

                }

            }

        }

    }

    for (var k = 0; k &lt; names.length; k++) {

        if (typeof this[names[k]] !== 'undefined' &amp;&amp; this[names[k]] !== null) {

            return this[names[k]];

        }

    }

    return null;

}



function parseDateValue(val) {

    if (val == null) return null;

    try {

        if (typeof val.isNull === 'function' &amp;&amp; val.isNull()) return null;

        if (typeof val.isDate === 'function' &amp;&amp; val.isDate()) {

            var jd = val.getDate();

            return jd != null ? new Date(jd.getTime()) : null;

        }

        if (typeof val.getDate === 'function') {

            var jd2 = val.getDate();

            if (jd2 != null) return new Date(jd2.getTime());

        }

        if (typeof val.getTime === 'function') {

            return new Date(val.getTime());

        }

        var s = safeTrim(val);

        if (s == "" || s == "-" || s == "0" || s.indexOf("#") >= 0 || s.toUpperCase() == "NULL" || s.toUpperCase() == "NONE") {

            return null;

        }

        if (s.toLowerCase().indexOf("pendiente") >= 0 || s.toLowerCase().indexOf("reliquidar") >= 0) {

            return null;

        }

        var num = Number(s);

        if (!isNaN(num) &amp;&amp; num > 10000 &amp;&amp; num &lt; 100000) {

            var utc_days = Math.floor(num - 25569);

            var utc_value = utc_days * 86400;

            var date_info = new Date(utc_value * 1000);

            return new Date(date_info.getUTCFullYear(), date_info.getUTCMonth(), date_info.getUTCDate());

        }

        var parts = s.split(/[-/ :.]/);

        if (parts.length >= 3) {

            var months = {ene:0, jan:0, feb:1, mar:2, abr:3, apr:3, may:4, jun:5, jul:6, ago:7, aug:7, sep:8, set:8, oct:9, nov:10, dic:11, dec:11};

            var p1_str = parts[1].toLowerCase().substr(0, 3);

            if (months[p1_str] !== undefined) {

                var day = parseInt(parts[0], 10);

                var mo = months[p1_str];

                var yr = parseInt(parts[2], 10);

                if (yr &lt; 100) yr += 2000;

                return new Date(yr, mo, day);

            }

            var p0 = parseInt(parts[0], 10);

            var p1 = parseInt(parts[1], 10);

            var p2 = parseInt(parts[2], 10);

            if (!isNaN(p0) &amp;&amp; !isNaN(p1) &amp;&amp; !isNaN(p2)) {

                if (p0 > 1900) return new Date(p0, p1 - 1, p2);

                if (p2 > 1900) return new Date(p2, p1 - 1, p0);

            }

        }

        var d = new Date(s);

        return isNaN(d.getTime()) ? null : d;

    } catch(e) {

        return null;

    }

}



function formatFechaKey(d) {

    if (d == null) return -1;

    try {

        if (typeof date2str === 'function') {

            var s = date2str(d, "yyyyMMdd");

            var n = parseInt(s, 10);

            if (!isNaN(n) &amp;&amp; n > 19000101) return n;

        }

    } catch(e) {}

    try {

        if (typeof d.getFullYear === 'function') {

            var yr = d.getFullYear();

            var mo = d.getMonth() + 1;

            var dy = d.getDate();

            return (yr * 10000) + (mo * 100) + dy;

        } else if (typeof d.getTime === 'function') {

            var jd = new Date(d.getTime());

            return (jd.getFullYear() * 10000) + ((jd.getMonth() + 1) * 100) + jd.getDate();

        }

    } catch(e) {}

    return -1;

}



// Extraccion no posicional por nombres reales de campo de la fuente

var v_cod = findRowValue(["Codigo unico", "Codigo Unico"], "Codigo");

var v_fecha = findRowValue(["Fecha"], "Fecha");

var v_id_activo = findRowValue(["ID ACTIVO", "ID_ACTIVO", "IdActivo"], "IDACTIVO");

var v_nom_activo = findRowValue(["NOMBRE ACTIVO", "NOMBRE_ACTIVO", "NombreActivo"], "NOMBREACTIVO");

// Columna fisica E (VALOR EN DOLAR): separada, NO alimenta ValorDescontadoCOP

var v_val_dolar = findRowValue(["VALOR EN DOLAR", "VALOR_EN_DOLAR", "ValorEnDolar"], "VALORENDOLAR");

// Columna fisica F (VALOR EN PESOS): fuente unica para ValorDescontadoCOP

var v_val = findRowValue(["VALOR EN PESOS", "VALOR_EN_PESOS", "ValorEnPesos"], "VALORENPESOS");

var v_reliq = findRowValue(["FECHA DE RELIQUIDACION", "Fecha de Reliquidacion", "Fecha de Reliquidacion", "FECHA_DE_RELIQUIDACION"], "RELIQUIDACI");



// Normalizacion de valores

var CodigoColaborador = safeTrim(v_cod);

var IdActivo = safeTrim(v_id_activo);

var NombreActivo = safeTrim(v_nom_activo);



// =============================================================================
// Limpieza estricta de VALOR EN PESOS (Columna fisica F)
// 1. Conservar el valor original de la celda en ValorOriginalFuente
// 2. NO eliminar puntos automaticamente ni forzar valores invalidos a cero
// 3. Celda numerica nativa de Excel: conservar valor numerico tal como esta
// 4. Texto con miles ($ y multiples puntos): remover $ y puntos de miles
// 5. Texto con coma decimal: reemplazar coma por punto
// 6. Errores (#REF!) y vacios: ValorDescontadoCOP = null y marcar para revision
// =============================================================================
var val_raw = safeTrim(v_val);
var ValorOriginalFuente = val_raw;
var ValorDescontadoCOP = null;
var EstadoValor = "NO_CLASIFICADO";
var MotivoRevisionValor = null;

if (val_raw == "" || val_raw == null) {
    // Regla 5: Celda vacia o solo espacios (1 fila: Fila 11)
    EstadoValor = "INVALIDO_VACIO";
    MotivoRevisionValor = "Celda sin valor (vacia o espacios) en fuente F2";
    ValorDescontadoCOP = null;
} else if (val_raw.indexOf("#") >= 0) {
    // Regla 4: Error de formula Excel (#REF!) (2 filas: Filas 16800 y 16801)
    EstadoValor = "INVALIDO_REF";
    MotivoRevisionValor = "Error de formula " + val_raw + " en celda original de Excel";
    ValorDescontadoCOP = null;
} else if (val_raw.indexOf(",") >= 0 &amp;&amp; val_raw.indexOf(".") &lt; 0 &amp;&amp; val_raw.indexOf("$") &lt; 0) {
    // Regla 3: Texto con separador decimal hispano (coma) (363 filas)
    var s_dec = val_raw.replace(/ /g, "").replace(",", ".");
    var n_dec = parseFloat(s_dec);
    if (!isNaN(n_dec)) {
        ValorDescontadoCOP = n_dec;
        EstadoValor = "VALIDO_TEXTO_DECIMAL";
    } else {
        EstadoValor = "AMBIGUO_FORMATO";
        MotivoRevisionValor = "Texto con coma no convertible a numero: " + val_raw;
        ValorDescontadoCOP = null;
    }
} else if (val_raw.indexOf("$") >= 0 || (val_raw.split(".").length > 2)) {
    // Regla 2: Texto con simbolo $ y/o multiples puntos de miles (3.766 filas)
    var s_mil = val_raw.replace("$", "").replace(/\./g, "").replace(/ /g, "");
    var n_mil = parseFloat(s_mil);
    if (!isNaN(n_mil)) {
        ValorDescontadoCOP = n_mil;
        EstadoValor = "VALIDO_TEXTO_MILES";
    } else {
        EstadoValor = "AMBIGUO_FORMATO";
        MotivoRevisionValor = "Texto de miles no convertible a numero: " + val_raw;
        ValorDescontadoCOP = null;
    }
} else {
    // Regla 1: Celda numerica nativa de Excel (65.313 filas)
    // Conserva el valor numerico tal como esta (enteros y flotantes con punto decimal)
    var s_num = val_raw.replace(/ /g, "");
    var n_num = parseFloat(s_num);
    if (!isNaN(n_num)) {
        ValorDescontadoCOP = n_num;
        EstadoValor = "VALIDO_NUMERICO";
    } else {
        EstadoValor = "AMBIGUO_FORMATO";
        MotivoRevisionValor = "Valor numerico no interpretable: " + val_raw;
        ValorDescontadoCOP = null;
    }
}



// Parseo seguro de fechas y generacion de claves dimensionales

var FechaDescuentoOriginal = parseDateValue(v_fecha);

var FechaDescuentoKey = formatFechaKey(FechaDescuentoOriginal);



var FechaReliqOriginal = parseDateValue(v_reliq);

var FechaReliqKey = formatFechaKey(FechaReliqOriginal);

</jsScript_script>
      </jsScript>
    </jsScripts>
