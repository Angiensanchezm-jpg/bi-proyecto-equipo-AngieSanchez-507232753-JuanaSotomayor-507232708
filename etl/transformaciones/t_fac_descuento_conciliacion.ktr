    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function cleanHeader(s) {
    if (s == null) return "";
    return String(s).toUpperCase().replace(/[^A-Z0-9]/g, "");
}

function safeTrim(val) {
    if (val == null) return "";
    var s = null;
    if (typeof val.isNull === 'function' &amp;&amp; val.isNull()) return "";
    if (typeof val.getString === 'function') s = val.getString();
    else s = String(val);
    if (s == null) return "";
    return String(s).replace(/^\s+|\s+$/g, "");
}

function findCol(names) {
    if (typeof row !== 'undefined' &amp;&amp; row != null &amp;&amp; typeof row.searchValueIndex === 'function') {
        for (var i = 0; i &lt; names.length; i++) {
            var idx = row.searchValueIndex(names[i]);
            if (idx >= 0) {
                var v = row.getValue(idx);
                if (v != null &amp;&amp; !v.isNull()) return v;
            }
        }
    }
    for (var k = 0; k &lt; names.length; k++) {
        if (typeof this[names[k]] !== 'undefined' &amp;&amp; this[names[k]] !== null) return this[names[k]];
    }
    return null;
}

function parseF1Date(val) {
    if (val == null) return "";
    try {
        if (typeof val.isNull === 'function' &amp;&amp; val.isNull()) return "";
        
        // 1. Objeto Date de Java o PDI
        if (typeof val.isDate === 'function' &amp;&amp; val.isDate()) {
            var jd = val.getDate();
            if (jd != null) {
                var sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
                return String(sdf.format(jd));
            }
        }
        if (typeof val.getDate === 'function') {
            var jd2 = val.getDate();
            if (jd2 != null) {
                var sdf2 = new java.text.SimpleDateFormat("yyyy-MM-dd");
                return String(sdf2.format(jd2));
            }
        }
        if (typeof val.getTime === 'function') {
            var sdf3 = new java.text.SimpleDateFormat("yyyy-MM-dd");
            return String(sdf3.format(new java.util.Date(val.getTime())));
        }
        
        var s = safeTrim(val);
        if (s == "" || s == "-" || s == "0" || s.indexOf("#") >= 0 || s.toUpperCase() == "NULL" || s.toUpperCase() == "NONE") return "";
        
        // 2. Serial numerico de Excel (ej: 45661 -> 2025-01-04)
        var num = Number(s);
        if (!isNaN(num) &amp;&amp; num > 20000 &amp;&amp; num &lt; 80000) {
            var utc_days = Math.floor(num - 25569);
            var utc_ms = utc_days * 86400 * 1000;
            var d_excel = new Date(utc_ms);
            var yrE = d_excel.getUTCFullYear();
            var moE = d_excel.getUTCMonth() + 1;
            var dyE = d_excel.getUTCDate();
            if (yrE >= 1900 &amp;&amp; moE >= 1 &amp;&amp; moE &lt;= 12 &amp;&amp; dyE >= 1 &amp;&amp; dyE &lt;= 31) {
                var smE = (moE &lt; 10) ? ("0" + moE) : ("" + moE);
                var sdE = (dyE &lt; 10) ? ("0" + dyE) : ("" + dyE);
                return yrE + "-" + smE + "-" + sdE;
            }
        }
        
        // 3. Cadena ISO (yyyy-MM-dd)
        if (s.indexOf("-") >= 0) {
            var partsIso = s.split(" ")[0].split("-");
            if (partsIso.length == 3 &amp;&amp; partsIso[0].length == 4) {
                var yI = parseInt(partsIso[0], 10);
                var mI = parseInt(partsIso[1], 10);
                var dI = parseInt(partsIso[2], 10);
                if (yI >= 1900 &amp;&amp; mI >= 1 &amp;&amp; mI &lt;= 12 &amp;&amp; dI >= 1 &amp;&amp; dI &lt;= 31) {
                    var smI = (mI &lt; 10) ? ("0" + mI) : ("" + mI);
                    var sdI = (dI &lt; 10) ? ("0" + dI) : ("" + dI);
                    return yI + "-" + smI + "-" + sdI;
                }
            }
        }
        
        // 4. Cadena con separador / o - (m/d/yy, d/m/yy, mm/dd/yyyy, dd/mm/yyyy)
        if (s.indexOf("/") >= 0 || s.indexOf("-") >= 0) {
            var sep = (s.indexOf("/") >= 0) ? "/" : "-";
            var parts = s.split(sep);
            if (parts.length == 3) {
                var p0 = parseInt(parts[0], 10);
                var p1 = parseInt(parts[1], 10);
                var p2 = parseInt(parts[2], 10);
                if (!isNaN(p0) &amp;&amp; !isNaN(p1) &amp;&amp; !isNaN(p2)) {
                    var y = p2;
                    if (y &lt; 100) y += 2000;
                    var m = 0;
                    var d = 0;
                    if (p0 > 12 &amp;&amp; p1 &lt;= 12) {
                        d = p0;
                        m = p1;
                    } else if (p1 > 12 &amp;&amp; p0 &lt;= 12) {
                        m = p0;
                        d = p1;
                    } else {
                        // En formato Excel nativo 14 (m/d/yy): p0 = mes, p1 = dia
                        m = p0;
                        d = p1;
                    }
                    if (y >= 1900 &amp;&amp; m >= 1 &amp;&amp; m &lt;= 12 &amp;&amp; d >= 1 &amp;&amp; d &lt;= 31) {
                        var sm = (m &lt; 10) ? ("0" + m) : ("" + m);
                        var sd = (d &lt; 10) ? ("0" + d) : ("" + d);
                        return y + "-" + sm + "-" + sd;
                    }
                }
            }
        }
    } catch(e) {}
    return "";
}

var v_cod = findCol(["Codigo unico", "CODIGO UNICO"]);
var CodF1_Norm = safeTrim(v_cod);

var v_liq = findCol(["Fecha liquidacion", "FECHA LIQUIDACION", "FechaLiquidacion"]);
var FechaLiqF1_Norm = parseF1Date(v_liq);

var v_reliq = findCol(["Fecha de Reliquidación", "FECHA DE RELIQUIDACION", "FechaReliquidacion"]);
var FechaReliqF1_Norm = parseF1Date(v_reliq);

var v_desc = findCol(["¿Con descuento?", "CON DESCUENTO", "ConDescuento", "TieneDescuento"]);
var descStr = safeTrim(v_desc).toLowerCase();
var ConDescF1_Flag = (descStr == "si" || descStr == "sí" || descStr == "s") ? 1 : 0;
</jsScript_script>
      </jsScript>
