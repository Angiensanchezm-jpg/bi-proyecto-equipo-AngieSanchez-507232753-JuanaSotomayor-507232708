  <step>
    <name>Evalua_Items_Conciliacion</name>
    <type>ScriptValueMod</type>
    <description>Clasifica los 233 items que van a conciliacion segun jerarquia validada consumiendo datos del flujo</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel/>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// =============================================================================
// Evalua_Items_Conciliacion
// Clasificacion deterministica consumiendo datos nativos de F1 provenientes del flujo PDI
// Sin lectura externa de archivos desde JavaScript
// Solo los 233 items huerfanos o ambiguos reciben EsItemConciliacion = 1
// Los 69.212 vinculables reciben EsItemConciliacion = 0
// =============================================================================

var EsItemConciliacion = 0;
var CategoriaAuditoria = "VINC_MONO";
var MotivoConciliacion = "Vinculado univocamente al contrato del colaborador";

var numContratos = 0;
if (typeof TotalContratosF1 !== 'undefined' &amp;&amp; TotalContratosF1 != null) {
    if (typeof TotalContratosF1.isNull === 'function' &amp;&amp; TotalContratosF1.isNull()) {
        numContratos = 0;
    } else if (typeof TotalContratosF1.getInteger === 'function') {
        numContratos = TotalContratosF1.getInteger();
    } else {
        numContratos = parseInt(TotalContratosF1, 10);
    }
}
if (isNaN(numContratos)) numContratos = 0;

var fDesc_str = "";
if (typeof FechaDescuentoOriginal !== 'undefined' &amp;&amp; FechaDescuentoOriginal != null) {
    try {
        var jd = (typeof FechaDescuentoOriginal.getDate === 'function') ? FechaDescuentoOriginal.getDate() : FechaDescuentoOriginal;
        if (jd != null) {
            var sdf_desc = new java.text.SimpleDateFormat("yyyy-MM-dd");
            fDesc_str = sdf_desc.format(jd);
        }
    } catch(e) {}
}

var fReliq_str = "";
if (typeof FechaReliqOriginal !== 'undefined' &amp;&amp; FechaReliqOriginal != null) {
    try {
        var jr = (typeof FechaReliqOriginal.getDate === 'function') ? FechaReliqOriginal.getDate() : FechaReliqOriginal;
        if (jr != null) {
            var sdf_rel = new java.text.SimpleDateFormat("yyyy-MM-dd");
            fReliq_str = sdf_rel.format(jr);
        }
    } catch(e2) {}
}

var sLiqList = "";
if (typeof FechasLiqF1_List !== 'undefined' &amp;&amp; FechasLiqF1_List != null) {
    if (typeof FechasLiqF1_List.getString === 'function') sLiqList = FechasLiqF1_List.getString();
    else sLiqList = String(FechasLiqF1_List);
}
if (sLiqList == null) sLiqList = "";

var sReliqList = "";
if (typeof FechasReliqF1_List !== 'undefined' &amp;&amp; FechasReliqF1_List != null) {
    if (typeof FechasReliqF1_List.getString === 'function') sReliqList = FechasReliqF1_List.getString();
    else sReliqList = String(FechasReliqF1_List);
}
if (sReliqList == null) sReliqList = "";

var nFlagDesc = 0;
if (typeof TotalConDescF1 !== 'undefined' &amp;&amp; TotalConDescF1 != null) {
    if (typeof TotalConDescF1.isNull === 'function' &amp;&amp; TotalConDescF1.isNull()) {
        nFlagDesc = 0;
    } else if (typeof TotalConDescF1.getInteger === 'function') {
        nFlagDesc = TotalConDescF1.getInteger();
    } else {
        nFlagDesc = parseInt(TotalConDescF1, 10);
    }
}
if (isNaN(nFlagDesc)) nFlagDesc = 0;

if (numContratos == 0) {
    // 1. Huerfanos: Colaborador cobrado en nomina que no figura en Paz y Salvos (47 filas)
    EsItemConciliacion = 1;
    CategoriaAuditoria = "CONC_HUERFANO";
    MotivoConciliacion = "Colaborador cobrado en nomina que no figura en Paz y Salvos (F1)";
} else if (numContratos == 1) {
    // 2. Vinculacion mono-contrato: 1 solo contrato en F1 (64.591 filas)
    EsItemConciliacion = 0;
    CategoriaAuditoria = "VINC_MONO";
    MotivoConciliacion = "Vinculado univocamente al contrato unico del colaborador";
} else {
    // 3. Multi-contrato: jerarquia estricta de desambiguacion (4.807 filas)
    var mLiq = 0;
    if (fDesc_str != "" &amp;&amp; sLiqList != "") {
        var arrLiq = sLiqList.split(",");
        for (var i = 0; i &lt; arrLiq.length; i++) {
            var itemLiq = String(arrLiq[i]).replace(/^\s+|\s+$/g, "");
            if (itemLiq == fDesc_str) mLiq++;
        }
    }
    
    if (mLiq == 1) {
        EsItemConciliacion = 0;
        CategoriaAuditoria = "VINC_MULTI_LIQ";
        MotivoConciliacion = "Vinculado univocamente por coincidencia de fecha de liquidacion";
    } else if (mLiq > 1) {
        EsItemConciliacion = 1;
        CategoriaAuditoria = "CONC_AMBIGUO_LIQ";
        MotivoConciliacion = "Fecha de descuento coincide con liquidacion de multiples contratos del colaborador";
    } else {
        var mReliq = 0;
        if (fReliq_str != "" &amp;&amp; sReliqList != "") {
            var arrReliq = sReliqList.split(",");
            for (var j = 0; j &lt; arrReliq.length; j++) {
                var itemReliq = String(arrReliq[j]).replace(/^\s+|\s+$/g, "");
                if (itemReliq == fReliq_str) mReliq++;
            }
        }
        
        if (mReliq == 1) {
            EsItemConciliacion = 0;
            CategoriaAuditoria = "VINC_MULTI_RELIQ";
            MotivoConciliacion = "Vinculado univocamente por coincidencia de fecha de reliquidacion";
        } else if (mReliq > 1) {
            EsItemConciliacion = 1;
            CategoriaAuditoria = "CONC_AMBIGUO_RELIQ";
            MotivoConciliacion = "Fecha de reliquidacion coincide con multiples contratos del colaborador";
        } else {
            if (nFlagDesc == 1) {
                EsItemConciliacion = 0;
                CategoriaAuditoria = "VINC_MULTI_FLAG";
                MotivoConciliacion = "Vinculado univocamente por flag unico de descuento en F1";
            } else if (nFlagDesc > 1) {
                EsItemConciliacion = 1;
                CategoriaAuditoria = "CONC_AMBIGUO_FLAG";
                MotivoConciliacion = "Multiples contratos del colaborador tienen flag de descuento Si";
            } else {
                EsItemConciliacion = 1;
                CategoriaAuditoria = "CONC_SIN_COINCIDENCIA";
                MotivoConciliacion = "Colaborador multi-contrato sin coincidencia de fechas ni flag de descuento";
            }
        }
    }
}

// Si la celda original contiene error de formula (#REF!) o esta vacia, se prioriza en el motivo
var sEstado = "";
if (typeof EstadoValor !== 'undefined' &amp;&amp; EstadoValor != null) {
    if (typeof EstadoValor.getString === 'function') sEstado = EstadoValor.getString();
    else sEstado = String(EstadoValor);
}
var sMotivoRev = "";
if (typeof MotivoRevisionValor !== 'undefined' &amp;&amp; MotivoRevisionValor != null) {
    if (typeof MotivoRevisionValor.getString === 'function') sMotivoRev = MotivoRevisionValor.getString();
    else sMotivoRev = String(MotivoRevisionValor);
}

if (sEstado == "INVALIDO_REF" || sEstado == "INVALIDO_VACIO") {
    MotivoConciliacion = sMotivoRev + " | " + MotivoConciliacion;
}
</jsScript_script>
      </jsScript>
